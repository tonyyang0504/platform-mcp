 {
  "name": "cap tail keeps the newest rows of an answer that ignores the page size",
  "category": "trading",
  "verb": "get_candles",
  "adapter": {
   "base_url": "https://api.example.test",
   "auth": {
    "type": "none"
   },
   "rate_per_second": 50,
   "tools": {
    "get_candles": {
     "method": "GET",
     "path": "/c",
     "max_limit": 720,
     "result": {
      "items": "$",
      "key": "candles",
      "cap": "tail",
      "fields": {
       "time": "iso:0",
       "open": "1",
       "high": "1",
       "low": "1",
       "close": "1"
      }
     }
    }
   }
  },
  "responses": [
   {
    "status": 200,
    "body": [
     [
      1790000000,
      0
     ],
     [
      1790000001,
      1
     ],
     [
      1790000002,
      2
     ],
     [
      1790000003,
      3
     ],
     [
      1790000004,
      4
     ],
     [
      1790000005,
      5
     ],
     [
      1790000006,
      6
     ],
     [
      1790000007,
      7
     ],
     [
      1790000008,
      8
     ],
     [
      1790000009,
      9
     ]
    ],
    "headers": {
     "content-type": "application/json"
    }
   }
  ],
  "args": {
   "symbol": "X",
   "interval": "1h",
   "limit": 3
  },
  "expect": {
   "candles.length": 3,
   "candles.0.close": 7
  }
 },
 {
