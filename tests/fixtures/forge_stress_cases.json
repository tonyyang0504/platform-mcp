[
 {
  "name": "star path: first value of an object keyed by an unknown name",
  "category": "trading",
  "verb": "get_ticker",
  "adapter": {
   "base_url": "https://api.example.test",
   "auth": {
    "type": "none"
   },
   "rate_per_second": 50,
   "tools": {
    "get_ticker": {
     "method": "GET",
     "path": "/t",
     "params": {
      "pair": "symbol"
     },
     "result": {
      "root": "result.*",
      "fields": {
       "symbol": "arg:symbol",
       "last": "num:c.0"
      }
     }
    }
   }
  },
  "responses": [
   {
    "status": 200,
    "body": {
     "error": [],
     "result": {
      "XXBTZUSD": {
       "c": [
        "1.5",
        "1"
       ]
      }
     }
    },
    "headers": {
     "content-type": "application/json"
    }
   }
  ],
  "args": {
   "symbol": "XBTUSD"
  },
  "expect": {
   "symbol": "XBTUSD",
   "last": 1.5
  }
 },
