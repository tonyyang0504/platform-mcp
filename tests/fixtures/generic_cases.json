{
 "_comment": "Generic entries (tools from the API's own operations): the same cases run in tests/test_generic_python.py and tests/generic.typescript.test.mjs.",
 "cases": [
  {
   "name": "root and default selection",
   "category": "generic",
   "verb": "list_items",
   "adapter": {
    "base_url": "https://api.example.test/v1",
    "auth": {
     "type": "none"
    },
    "rate_per_second": 1000,
    "tools": {
     "list_items": {
      "title": "List items",
      "description": "List the items that match a query.",
      "method": "GET",
      "path": "/items",
      "input": {
       "type": "object",
       "properties": {
        "q": {
         "type": "string",
         "description": "Text to match."
        },
        "per_page": {
         "type": "integer"
        }
       },
       "required": [
        "q"
       ]
      },
      "params": {
       "q": "q",
       "per_page": "per_page"
      },
      "result": {
       "root": "items",
       "select": [
        "id",
        "owner.login"
       ]
      },
      "docs": "https://docs.example.test/items#list"
     },
     "get_item": {
      "description": "One item by id.",
      "method": "GET",
      "path": "/items/{item_id}",
      "input": {
       "type": "object",
       "properties": {
        "item_id": {
         "type": "string"
        }
       },
       "required": [
        "item_id"
       ]
      },
      "docs": "https://docs.example.test/items#get"
     },
     "search_items": {
      "description": "Full-text search (a POST that only reads).",
      "method": "POST",
      "path": "/search",
      "read_only": true,
      "input": {
       "type": "object",
       "properties": {
        "query": {
         "type": "string"
        },
        "lang": {
         "type": "string",
         "enum": [
          "en",
          "de"
         ]
        }
       },
       "required": [
        "query"
       ]
      },
      "body": {
       "query": "query",
       "filters.lang": "lang"
      },
      "result": {
       "max_items": 2
      },
      "docs": "https://docs.example.test/search"
     },
     "delete_item": {
      "description": "Delete an item.",
      "method": "DELETE",
      "path": "/items/{item_id}",
      "input": {
       "type": "object",
       "properties": {
        "item_id": {
         "type": "string"
        }
       },
       "required": [
        "item_id"
       ]
      },
      "docs": "https://docs.example.test/items#delete"
     }
    }
   },
   "args": {
    "q": "foo"
   },
   "responses": [
    {
     "status": 200,
     "body": {
      "meta": {
       "n": 3
      },
      "items": [
       {
        "id": 1,
        "name": "a",
        "owner": {
         "login": "x"
        },
        "extra": true
       },
       {
        "id": 2,
        "name": "b",
        "owner": {
         "login": "y"
        }
       },
       {
        "id": 3,
        "name": "c"
       }
      ]
     }
    }
   ],
   "expect": {
    "data.length": 3,
    "data.0": {
     "id": 1,
     "owner.login": "x"
    },
    "data.2": {
     "id": 3,
     "owner.login": null
    }
   },
   "request": {
    "count": 1,
    "path": "/v1/items",
    "query": {
     "q": "foo"
    }
   }
  },
