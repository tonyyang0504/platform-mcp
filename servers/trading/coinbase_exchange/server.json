{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/coinbase_exchange-mcp",
 "description": "Coinbase Exchange (trading): list_markets, get_ticker, get_candles. Every tool maps to a documented ",
 "version": "0.1.0",
