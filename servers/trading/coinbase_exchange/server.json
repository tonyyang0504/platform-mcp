   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "coinbase_exchange"
    }
   ],
   "environmentVariables": []
  }
 ]
}
