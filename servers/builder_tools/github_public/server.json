{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/github_public-mcp",
 "description": "GitHub (public search, no token) (builder tools): list_items, get_item. Every tool maps to a documen",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://docs.github.com/en/rest/search/search",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "github_public"
    }
   ],
   "environmentVariables": []
  }
 ]
}
