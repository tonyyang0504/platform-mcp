{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/depop-mcp",
 "description": "Depop (ecommerce channels): me, update_listing, set_inventory, end_listing, list_orders. Every tool ",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://partnerapi.depop.com/api-docs/terms/",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "depop"
    }
   ],
   "environmentVariables": [
    {
     "name": "PLATFORM_MCP_DEPOP_API_KEY",
     "description": "Depop Partner API key (issued by Depop to approved enterprise partners; API-key tokens carry every scope); sent as Authorization: Bearer.",
     "isRequired": true,
     "isSecret": true
    },
    {
     "name": "PLATFORM_MCP_DEPOP_API_HOST",
     "description": "partnerapi.depop.com (production) or partnerapi-staging.depop.com (staging).",
     "isRequired": true,
     "isSecret": false
    }
   ]
  }
 ]
}
