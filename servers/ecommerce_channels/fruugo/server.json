{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/fruugo-mcp",
 "description": "Fruugo (ecommerce channels): me, list_orders, mark_shipped, set_inventory, end_listing. Every tool m",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://fruugo.atlassian.net/wiki/spaces/RR/pages/66158670/Order+API",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "fruugo"
    }
   ],
   "environmentVariables": [
    {
     "name": "PLATFORM_MCP_FRUUGO_USERNAME",
     "description": "Fruugo Retailer Portal login (the Order and Stock Status APIs use the portal credentials with HTTP Basic).",
     "isRequired": true,
     "isSecret": true
    },
    {
     "name": "PLATFORM_MCP_FRUUGO_PASSWORD",
     "description": "Fruugo Retailer Portal password.",
     "isRequired": true,
     "isSecret": true
    }
   ]
  }
 ]
}
