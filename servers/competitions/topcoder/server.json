{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/topcoder-competitions-mcp",
 "description": "Topcoder (competitions): discover, get_competition, standings. Every tool maps to a documented endpo",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://github.com/topcoder-platform/challenge-api-v6/blob/develop/docs/swagger.yaml",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "competitions/topcoder"
    }
   ],
   "environmentVariables": []
  }
 ]
}
