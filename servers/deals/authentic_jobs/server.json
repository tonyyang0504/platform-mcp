{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/authentic_jobs-deals-mcp",
 "description": "Authentic Jobs (deals): search_postings, get_posting. Every tool maps to a documented endpoint.",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://authenticjobs.com/ (RSS feed linked in the footer)",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "deals/authentic_jobs"
    }
   ],
   "environmentVariables": []
  }
 ]
}
