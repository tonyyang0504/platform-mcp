{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/eu_funding-mcp",
 "description": "EU Funding & Tenders Portal (deals): me, search_postings, get_posting. Every tool maps to a document",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/support/apis",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
