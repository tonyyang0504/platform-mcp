   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "eu_funding"
    }
   ],
   "environmentVariables": []
  }
 ]
}
