{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/bloggingpro_jobs-mcp",
 "description": "BloggingPro Job Board (deals): search_postings, get_posting. Every tool maps to a documented endpoin",
