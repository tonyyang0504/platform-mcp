{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/federal_reserve_press-mcp",
 "description": "Federal Reserve Board - press releases (RSS) (market data): get_news. Every tool maps to a documente",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://www.federalreserve.gov/feeds/feeds.htm",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "federal_reserve_press"
    }
   ],
   "environmentVariables": []
  }
 ]
}
