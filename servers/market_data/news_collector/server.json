{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/news_collector-mcp",
 "description": "News RSS/GDELT/Fear&Greed (market data): get_news. Every tool maps to a documented endpoint.",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "news_collector"
    }
   ],
   "environmentVariables": []
  }
 ]
}
