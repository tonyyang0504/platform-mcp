{
 "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
 "name": "io.github.tonyyang0504/binance_vision_collector-mcp",
 "description": "Binance Vision historical CDN (market data): me, get_candles, search_symbols. Every tool maps to a d",
 "version": "0.1.0",
 "repository": {
  "url": "https://github.com/tonyyang0504/platform-mcp",
  "source": "github"
 },
 "websiteUrl": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/market-data-endpoints",
 "packages": [
  {
   "registryType": "pypi",
   "identifier": "platform-mcp-hub",
   "version": "0.1.0",
   "runtimeHint": "uvx",
   "transport": {
    "type": "stdio"
   },
   "packageArguments": [
    {
     "type": "positional",
     "value": "serve"
    },
    {
     "type": "positional",
     "value": "binance_vision_collector"
    }
   ],
   "environmentVariables": []
  }
 ]
}
